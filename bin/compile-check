#!/usr/bin/env bash
# Byte-compile every config file with Doom's macros stubbed out, the bodies
# of after!/use-package!/add-hook!/defadvice! included. Catches wrong arity,
# malformed forms, obsolete functions and typos. Any warning fails the run.
set -euo pipefail
cd "$(dirname "$0")/.."
emacs --batch -Q -l test/compile-check.el
