;;; test/ai-overlay-test.el -*- lexical-binding: t; -*-

(defmacro +ai-overlay-test--in-buffer (text &rest body)
  (declare (indent 1))
  `(with-temp-buffer
     (insert ,text)
     ,@body))

(defun +ai-overlay-test--overlays (tag)
  (sort (seq-filter (lambda (o) (overlay-get o tag)) (overlays-in (point-min) (point-max)))
        (lambda (a b) (< (overlay-start a) (overlay-start b)))))

(ert-deftest +ai--overlay-column/sits-two-past-the-longest-line-or-fill-column ()
  (+ai-overlay-test--in-buffer "a\nbbbbbbbbbbbbbbb\n"
    (let ((fill-column 5))
      (ert-info ("with short fill-column the longest line should decide")
        (should (= 17 (+ai--overlay-column nil)))))
    (let ((fill-column 40))
      (ert-info ("a wider fill-column should win over the longest line")
        (should (= 42 (+ai--overlay-column nil)))))
    (ert-info ("a fixed column should be used as is")
      (should (= 70 (+ai--overlay-column 70))))))

(ert-deftest +ai--overlay-wrap/breaks-at-words-within-the-width ()
  (ert-info ("text wider than the width should break between words")
    (should (equal '("aaa bbb" "ccc") (+ai--overlay-wrap "aaa bbb ccc" 7))))
  (ert-info ("text that fits should stay one line")
    (should (equal '("aaa") (+ai--overlay-wrap "aaa" 7)))))

(ert-deftest +ai--overlay-free-rows/counts-unannotated-lines-below ()
  (let ((annotated '(1 3)))
    (ert-info ("line 1 should have one free row before the annotated line 3")
      (should (= 1 (+ai--overlay-free-rows 1 annotated 5))))
    (ert-info ("line 3 should have the two remaining lines free")
      (should (= 2 (+ai--overlay-free-rows 3 annotated 5))))
    (ert-info ("the last line should have no free rows")
      (should (= 0 (+ai--overlay-free-rows 5 annotated 5))))))

(ert-deftest +ai--overlay-chunks/uses-free-rows-then-cuts-with-an-ellipsis ()
  (let ((text (propertize "aaa bbb ccc ddd" 'face 'italic)))
    (ert-info ("with enough free rows every chunk should appear")
      (should (equal '("aaa bbb" "ccc ddd")
                     (mapcar #'substring-no-properties (+ai--overlay-chunks text 7 3)))))
    (ert-info ("with no free row the text should be cut on its own row with an ellipsis")
      (should (equal '("aaa bb…")
                     (mapcar #'substring-no-properties (+ai--overlay-chunks text 7 0)))))
    (ert-info ("every chunk should keep the face of the text")
      (should (seq-every-p (lambda (c) (eq 'italic (get-text-property 0 'face c)))
                           (+ai--overlay-chunks text 7 3))))))

(ert-deftest +ai--overlay-render-column/aligns-each-text-past-the-code ()
  (+ai-overlay-test--in-buffer "a\nbbbb\nc\n"
    (+ai--overlay-render-column 'tag '((1 . "x") (3 . "y")) 12 20)
    (let* ((overlays (+ai-overlay-test--overlays 'tag))
           (text (overlay-get (car overlays) 'after-string)))
      (ert-info ("each annotated line should get its own overlay at its end")
        (should (equal '(2 9) (mapcar #'overlay-start overlays))))
      (ert-info ("the overlay should start with a stretch aligned to the column")
        (should (equal '(space :align-to 12) (get-text-property 0 'display text))))
      (ert-info ("the text should follow the stretch")
        (should (equal " x" (substring-no-properties text 1)))))))

(ert-deftest +ai--overlay-render-column/wraps-into-free-rows-but-not-onto-blocked ()
  (+ai-overlay-test--in-buffer "a\nb\nc\n"
    (+ai--overlay-render-column 'tag '((1 . "aaa bbb ccc")) 4 7)
    (ert-info ("the text should spill onto the free line below")
      (should (equal '(2 4) (mapcar #'overlay-start (+ai-overlay-test--overlays 'tag)))))
    (+ai--overlay-clear 'tag)
    (+ai--overlay-render-column 'tag '((1 . "aaa bbb ccc")) 4 7 2)
    (ert-info ("with line 2 blocked the text should be cut on its own row instead")
      (should (equal '(2) (mapcar #'overlay-start (+ai-overlay-test--overlays 'tag)))))))

(ert-deftest +ai--overlay-margin/shows-the-text-in-the-right-margin ()
  (+ai-overlay-test--in-buffer "a\nbb\n"
    (+ai--overlay-margin 'tag 2 "w" 6)
    (let* ((overlay (car (+ai-overlay-test--overlays 'tag)))
           (spec (get-text-property 0 'display (overlay-get overlay 'before-string))))
      (ert-info ("the margin overlay should start at the beginning of its line")
        (should (= 3 (overlay-start overlay))))
      (ert-info ("the string should be displayed in the right margin")
        (should (equal '(margin right-margin) (car spec))))
      (ert-info ("the margin should hold the text")
        (should (equal "w" (substring-no-properties (cadr spec))))))))

(ert-deftest +ai--overlay-fit/truncates-to-the-width ()
  (ert-info ("long text should be cut with an ellipsis to the width")
    (should (equal "abcde…" (+ai--overlay-fit "abcdefghij" 6))))
  (ert-info ("short text should pass through")
    (should (equal "abc" (+ai--overlay-fit "abc" 6)))))

(ert-deftest +ai--overlay-eol/hangs-the-text-off-the-line-end ()
  (+ai-overlay-test--in-buffer "ab\ncd\n"
    (+ai--overlay-eol 'tag 1 "x")
    (let ((overlay (car (+ai-overlay-test--overlays 'tag))))
      (ert-info ("the overlay should sit at the end of its line")
        (should (= 3 (overlay-start overlay))))
      (ert-info ("the text should follow an arrow")
        (should (equal "  ⟵ x" (substring-no-properties (overlay-get overlay 'after-string))))))))

(ert-deftest +ai--overlay-clear/removes-only-the-tagged ()
  (+ai-overlay-test--in-buffer "a\n"
    (let ((other (make-overlay 1 2)))
      (+ai--overlay-eol 'tag 1 "x")
      (+ai--overlay-eol 'other-tag 1 "y")
      (+ai--overlay-clear 'tag)
      (ert-info ("clearing should drop the tagged overlays")
        (should (null (+ai-overlay-test--overlays 'tag))))
      (ert-info ("clearing should leave overlays with another tag alone")
        (should (= 1 (length (+ai-overlay-test--overlays 'other-tag)))))
      (ert-info ("clearing should leave untagged overlays alone")
        (should (overlay-buffer other))))))
